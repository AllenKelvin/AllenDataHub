{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/store/[slug].js": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/api/store/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
